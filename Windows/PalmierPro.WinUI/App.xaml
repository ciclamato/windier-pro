<Application x:Class="PalmierPro.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F0EEE7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F9F8F3" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FDFCF8" />
    <SolidColorBrush x:Key="LineBrush" Color="#28151412" />
    <SolidColorBrush x:Key="InkBrush" Color="#161513" />
    <SolidColorBrush x:Key="MutedBrush" Color="#77736B" />
    <SolidColorBrush x:Key="FaintBrush" Color="#A7A39B" />
    <SolidColorBrush x:Key="VioletBrush" Color="#7770C9" />
    <SolidColorBrush x:Key="VioletWashBrush" Color="#E8E5F4" />
    <LinearGradientBrush x:Key="CanvasGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F3F1EA" Offset="0" />
      <GradientStop Color="#E8E6DF" Offset="0.58" />
      <GradientStop Color="#E4E1EA" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PreviewGradient" Center="0.58,0.15" RadiusX="0.9" RadiusY="0.95">
      <GradientStop Color="#484550" Offset="0" />
      <GradientStop Color="#1B1A1D" Offset="0.55" />
      <GradientStop Color="#101010" Offset="1" />
    </RadialGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#DDFDFCF8" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Resources>
</Application>
