<Window x:Class="PalmierPro.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palmier Pro">
  <Grid Background="{StaticResource CanvasGradient}" Padding="26,20,26,22" AllowDrop="True" DragOver="Canvas_DragOver" Drop="Canvas_Drop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="230" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource InkBrush}" Margin="0,0,10,0">
            <TextBlock Text="P" Foreground="{StaticResource SurfaceBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="PALMIER" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="An editor for moving images" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="39,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ProjectStatus" Text="UNTITLED PROJECT" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Content="Open" Click="OpenProject_Click" />
        <Button Content="Save" Click="SaveProject_Click" />
        <Button Content="Undo" Click="Undo_Click">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></Button.KeyboardAccelerators>
        </Button>
        <Button Content="Redo" Click="Redo_Click">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></Button.KeyboardAccelerators>
        </Button>
        <Button Content="Import" Click="Import_Click" Background="{StaticResource InkBrush}" Foreground="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InkBrush}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#DFF9F8F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="MEDIA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Your visual library" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0" />
            <TextBlock Text="Drop files anywhere to begin." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
          </StackPanel>
          <ListView Grid.Row="1" x:Name="MediaList" ItemsSource="{x:Bind MediaItems, Mode=OneWay}" SelectionChanged="MediaList_SelectionChanged" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Padding="9" Margin="0,0,0,5" Background="#CFFDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}" />
                      <TextBlock Text="{Binding DurationLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Padding="6,1" Margin="8,0,0,0" Click="RemoveClip_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" x:Name="ClipSummary" Text="No clips" Foreground="{StaticResource MutedBrush}" Margin="4,10,4,0" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PreviewGradient}" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Image x:Name="PreviewFrame" Stretch="Uniform" Margin="18" />
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" HorizontalAlignment="Center">
              <TextBlock Text="✦" Foreground="#E8E3F4" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Your canvas is quiet" Foreground="#F2EFE8" FontSize="22" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="Import a clip to begin shaping the sequence." Foreground="#A9A4AA" Margin="0,7,0,0" />
          </StackPanel>
          <Border VerticalAlignment="Bottom" Background="#CC101010" Padding="12" CornerRadius="0,0,12,12">
            <TextBlock x:Name="PreviewStatus" Text="No media selected" Foreground="#A9A4AA" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="#DFF9F8F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
          <TextBlock Text="INSPECTOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="A little room to think" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0" />
          <TextBlock Text="Select a clip to reveal its controls." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20" />
          <Border Background="{StaticResource VioletWashBrush}" CornerRadius="8" Padding="12">
            <StackPanel>
              <TextBlock Text="AI / AGENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource VioletBrush}" />
              <TextBlock Text="Describe a change" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
              <TextBlock Text="Connect Codex or another provider when you are ready." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12" />
              <Button Content="Connect agent" Click="ConnectAgent_Click" Background="{StaticResource SurfaceElevatedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#DFF9F8F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="TIMELINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="  /  00:00:00:00" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
          <TextBlock Text="  /  30 FPS" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
        </StackPanel>
        <Border Height="58" Background="#66FDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource InkBrush}" Margin="0,0,10,0">
              <TextBlock Text="V1" Foreground="{StaticResource SurfaceBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Video track" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Import order becomes your first sequence." Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
          </StackPanel>
        </Border>
        <Border Height="58" Background="#66FDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7" Padding="10">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource VioletWashBrush}" Margin="0,0,10,0">
              <TextBlock Text="A1" Foreground="{StaticResource VioletBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Audio track" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Audio follows the shared playback clock." Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
