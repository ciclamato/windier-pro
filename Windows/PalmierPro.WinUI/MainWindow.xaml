<Window x:Class="PalmierPro.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palmier Pro">
  <Grid Background="{StaticResource CanvasGradient}" Padding="26,20,26,22" AllowDrop="True" DragOver="Canvas_DragOver" Drop="Canvas_Drop" KeyDown="Editor_KeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="230" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource InkBrush}" Margin="0,0,10,0">
            <TextBlock Text="P" Foreground="{StaticResource SurfaceBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="PALMIER" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="An editor for moving images" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="39,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ProjectStatus" Text="UNTITLED PROJECT" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Content="Open" Click="OpenProject_Click" />
        <Button Content="Save" Click="SaveProject_Click" />
        <Button Content="Export" Click="Export_Click" />
        <Button Content="Audio" Click="ConfigureAudio_Click" />
        <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click" />
        <Button Content="Split" Click="SplitSelected_Click" />
        <Button Content="Undo" Click="Undo_Click">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></Button.KeyboardAccelerators>
        </Button>
        <Button Content="Redo" Click="Redo_Click">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></Button.KeyboardAccelerators>
        </Button>
        <Button Content="Import" Click="Import_Click" Background="{StaticResource InkBrush}" Foreground="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InkBrush}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#DFF9F8F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="MEDIA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Your visual library" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0" />
            <TextBlock Text="Drop files anywhere to begin." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            <TextBox x:Name="MediaSearchBox" PlaceholderText="Search media and captions" TextChanged="MediaSearchBox_TextChanged" Margin="0,10,0,0" />
          </StackPanel>
          <ListView Grid.Row="1" x:Name="MediaList" ItemsSource="{x:Bind MediaItems, Mode=OneWay}" SelectionChanged="MediaList_SelectionChanged" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Padding="9" Margin="0,0,0,5" Background="#CFFDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}" />
                      <TextBlock Text="{Binding DurationLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Padding="6,1" Margin="8,0,0,0" Click="RemoveClip_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" x:Name="ClipSummary" Text="No clips" Foreground="{StaticResource MutedBrush}" Margin="4,10,4,0" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PreviewGradient}" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Image x:Name="PreviewFrame" Stretch="Uniform" Margin="18" />
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" HorizontalAlignment="Center">
              <TextBlock Text="✦" Foreground="#E8E3F4" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Bring in your first clip" Foreground="#F2EFE8" FontSize="22" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="Import a clip to begin shaping the sequence." Foreground="#A9A4AA" Margin="0,7,0,0" />
            <Button Content="Import media" Click="Import_Click" HorizontalAlignment="Center" Margin="0,14,0,0" Background="#33FFFFFF" Foreground="#F2EFE8" BorderBrush="#55FFFFFF" />
          </StackPanel>
          <Border VerticalAlignment="Bottom" Background="#CC101010" Padding="12" CornerRadius="0,0,12,12">
            <TextBlock x:Name="PreviewStatus" Text="No media selected" Foreground="#A9A4AA" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="#DFF9F8F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
          <StackPanel x:Name="InspectorPanel">
          <TextBlock Text="INSPECTOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="InspectorTitle" Text="Clip controls" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0" />
          <TextBlock x:Name="InspectorSubtitle" Text="Select a clip to edit its timing and mix." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" />
          <Grid x:Name="InspectorControls" Visibility="Collapsed" Margin="0,0,0,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Text="Opacity" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
            <NumberBox x:Name="OpacityInput" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" SpinButtonPlacementMode="Compact" Margin="0,0,0,7" />
            <TextBlock Grid.Row="1" Text="Volume" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
            <NumberBox x:Name="VolumeInput" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="4" SmallChange="0.1" SpinButtonPlacementMode="Compact" Margin="0,0,0,7" />
            <TextBlock Grid.Row="2" Text="Speed" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
            <NumberBox x:Name="SpeedInput" Grid.Row="2" Grid.Column="1" Minimum="0.05" Maximum="16" SmallChange="0.25" SpinButtonPlacementMode="Compact" Margin="0,0,0,7" />
            <TextBlock Grid.Row="3" Text="Duration (frames)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumberBox x:Name="DurationInput" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="1000000" SmallChange="1" SpinButtonPlacementMode="Compact" />
          </Grid>
          <StackPanel x:Name="InspectorActions" Visibility="Collapsed" Orientation="Horizontal" Spacing="7" Margin="0,0,0,14">
            <Button Content="Apply" Click="ApplyInspector_Click" />
            <Button Content="Ripple delete" Click="RippleDelete_Click" />
          </StackPanel>
          <Border Background="{StaticResource VioletWashBrush}" CornerRadius="8" Padding="12">
            <StackPanel>
              <TextBlock Text="AI / AGENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource VioletBrush}" />
              <TextBlock Text="Describe a change" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
              <TextBlock Text="Use a connected provider to turn an instruction into an undoable edit." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Content="Connect agent" Click="ConnectAgent_Click" Background="{StaticResource SurfaceElevatedBrush}" />
                <Button Content="Add marker" Click="AddMarker_Click" Background="{StaticResource SurfaceElevatedBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#DFF9F8F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="TIMELINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="TimelineReadout" Text="  /  00:00:00:00" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
          <TextBlock x:Name="TimelineFps" Text="  /  30 FPS" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
          <TextBlock Text="  /  click empty timeline to seek · drag edges to trim" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
          <Canvas x:Name="TimelineCanvas" Background="#22FDFCF8" PointerPressed="TimelineCanvas_PointerPressed" />
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
