<Window x:Class="PalmierPro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palmier Pro"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        Background="{StaticResource WindowGradient}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        Drop="Window_Drop">
  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="230" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource InkBrush}" Margin="0,0,10,0">
            <TextBlock Text="P" Foreground="{StaticResource PanelBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="PALMIER" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="An editor for moving images" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="39,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="UNTITLED PROJECT" Foreground="{StaticResource FaintTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
        <Button Content="Open" Click="OpenProject_Click" />
        <Button Content="Save" Click="SaveProject_Click" />
        <Button Content="Import" Click="Import_Click" Background="{StaticResource InkBrush}" Foreground="{StaticResource PanelBrush}" BorderBrush="{StaticResource InkBrush}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="250" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrushTranslucent}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10">
            <TextBlock Text="MEDIA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="Your visual library" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
            <TextBlock Text="Drop files anywhere to begin." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
          </StackPanel>
          <ListBox x:Name="MediaList" ItemsSource="{Binding Clips}" SelectionChanged="MediaList_SelectionChanged" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="9" Margin="0,0,0,5" Background="#8CFDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7">
                  <DockPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="×" Padding="6,1" Margin="8,0,0,0" Click="RemoveClip_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
            <Separator Background="{StaticResource PanelBorderBrush}" />
            <TextBlock Text="{Binding ClipSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PreviewGradient}" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="Preview_MediaOpened" MediaEnded="Preview_MediaEnded" />
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" HorizontalAlignment="Center">
              <TextBlock Text="✦" Foreground="#E8E3F4" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Your canvas is quiet" Foreground="#F2EFE8" FontSize="22" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="Import a clip to begin shaping the sequence." Foreground="#A9A4AA" Margin="0,7,0,0" />
          </StackPanel>
          <Border VerticalAlignment="Bottom" Background="#CC101010" Padding="12" CornerRadius="0,0,12,12">
            <DockPanel>
              <Button DockPanel.Dock="Left" Content="Play / pause" Click="PlayPause_Click" Background="#26FFFFFF" Foreground="#F2EFE8" BorderBrush="#44FFFFFF" />
              <TextBlock x:Name="PreviewStatus" Text="No media selected" VerticalAlignment="Center" Foreground="#A9A4AA" />
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource PanelBrushTranslucent}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
          <TextBlock Text="INSPECTOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="A little room to think" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
          <TextBlock Text="Select a clip to reveal its controls." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,20" />
          <Border Background="{StaticResource AccentWashBrush}" CornerRadius="8" Padding="12">
            <StackPanel>
              <TextBlock Text="AI / AGENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="Describe a change" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock Text="Connect Codex or another provider when you are ready." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
              <Button Content="Connect agent" Background="{StaticResource PanelBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrushTranslucent}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="TIMELINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="  /  00:00:00:00" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Margin="12,0,0,0" />
          <TextBlock Text="  /  30 FPS" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Margin="12,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
          <Border Height="58" Background="#66FDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Background="{StaticResource InkBrush}" Margin="0,0,10,0">
                <TextBlock Text="V1" Foreground="{StaticResource PanelBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Video track" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Import order becomes your first sequence." Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
            </DockPanel>
          </Border>
          <Border Height="58" Background="#66FDFCF8" BorderBrush="#17151314" BorderThickness="1" CornerRadius="7" Padding="10">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentWashBrush}" Margin="0,0,10,0">
                <TextBlock Text="A1" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Audio track" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Audio follows the shared playback clock." Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
            </DockPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
