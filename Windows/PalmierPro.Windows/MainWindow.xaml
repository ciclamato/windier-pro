<Window x:Class="PalmierPro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palmier Pro — Windows Preview"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        Drop="Window_Drop">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Palmier Pro" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Windows preview" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Import media" Click="Import_Click" />
        <Button Content="Open project" Click="OpenProject_Click" />
        <Button Content="Save project" Click="SaveProject_Click" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10">
            <TextBlock Text="Media" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Drop video, audio, or image files anywhere in the window." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <ListBox x:Name="MediaList" ItemsSource="{Binding Clips}" SelectionChanged="MediaList_SelectionChanged" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8" Margin="0,0,0,4" Background="#22262E" CornerRadius="5">
                  <DockPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <Button DockPanel.Dock="Right" Content="×" Padding="6,1" Margin="8,0,0,0" Click="RemoveClip_Click" Tag="{Binding}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding ClipSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="4,10,4,0" />
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="#090A0D" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="Preview_MediaOpened" MediaEnded="Preview_MediaEnded" />
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Import media to start" FontSize="22" HorizontalAlignment="Center" />
            <TextBlock Text="Your selected clip will preview here." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
          </StackPanel>
          <Border VerticalAlignment="Bottom" Background="#CC111318" Padding="12">
            <DockPanel>
              <Button DockPanel.Dock="Left" Content="Play / pause" Click="PlayPause_Click" />
              <TextBlock x:Name="PreviewStatus" Text="No media selected" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="Timeline" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="Import order is the current timeline order. Full editing and export are next milestones." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
