<Application x:Class="PalmierPro.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#101216" />
    <SolidColorBrush x:Key="PanelBrush" Color="#181B21" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2F38" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA5B4" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#252A33" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
